# ==============================================================================
# Staging Environment Profile (.env.staging.example)
# ==============================================================================
# Target: Pre-production cloud staging server (e.g. Render/Railway staging)
# ==============================================================================

APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_URL=https://staging.legalintel.ai
CORS_ORIGINS=https://staging.legalintel.ai,https://legalintel-staging.vercel.app
STRICT_SECURITY_HEADERS=true
SECURE_COOKIES=true

# Relational Database (Managed cloud staging database instance)
DATABASE_URL=postgresql://staging_user:YOUR_STAGING_DB_PASSWORD@staging-postgres.render.com:5432/legal_ai_staging
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=YOUR_STAGING_DB_PASSWORD
POSTGRES_DB=legal_ai_staging

# Authentication (Must be cryptographically random 256-bit key)
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_FOR_STAGING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=40
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=40

# SMTP (Staging mail trap or dedicated staging inbox)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_staging_mailtrap_user
SMTP_PASSWORD=your_staging_mailtrap_password
SMTP_FROM_EMAIL=staging-noreply@legalintel.ai
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# AI / Google Gemini
GEMINI_API_KEY=YOUR_STAGING_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_FREE_TIER_DAILY_LIMIT=1500
AI_WARNING_THRESHOLD_PERCENT=80.0

# LangSmith Observability (Staging project tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=YOUR_LANGCHAIN_API_KEY
LANGCHAIN_PROJECT=legal-intel-staging
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Storage
CHROMA_PERSIST_DIR=/app/chroma_data
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Diagnostics Exposure (Security Hardening) ---
# Keep False in production. When False, unauthenticated /health/db and /metrics
# return only a minimal liveness signal; full diagnostics require an authenticated
# admin (/admin/db-health, /admin/telemetry). Set a METRICS_TOKEN to allow a
# trusted Prometheus scraper to read /metrics via a bearer token.
EXPOSE_PUBLIC_DIAGNOSTICS=False
METRICS_TOKEN=
