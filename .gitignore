# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
# Anchor to repo root only. An unanchored `dist/` also matches `frontend/dist`,
# and Hugging Face Spaces filters .gitignore'd paths out of the running
# filesystem (honoring the match but NOT the `!frontend/dist` negations), which
# stripped the compiled React SPA from the live Space. `/dist/` cannot match
# `frontend/dist`, so the committed SPA is served in production.
/dist/
build/
*.egg
venv/
.venv/
venv_linux/
backend/venv_linux/

# Environment & Secrets (Day 50)
.env
.env.*
!.env.example
!.env.*.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*

# Uploads
uploads/*
!uploads/.gitkeep

