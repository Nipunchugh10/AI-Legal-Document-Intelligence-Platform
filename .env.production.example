# ==============================================================================
# Production Environment Profile (.env.production.example)
# ==============================================================================
# Target: Production deployment (e.g. Railway / Render / AWS ECS + Vercel)
# ==============================================================================

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_URL=https://app.legalintel.ai
CORS_ORIGINS=https://app.legalintel.ai
STRICT_SECURITY_HEADERS=true
SECURE_COOKIES=true

# Relational Database (Managed PostgreSQL RDS / Railway / Neon with SSL required)
DATABASE_URL=postgresql://prod_user:YOUR_COMPLEX_PROD_DB_PASSWORD@prod-db.railway.internal:5432/legal_ai_prod?sslmode=require
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=YOUR_COMPLEX_PROD_DB_PASSWORD
POSTGRES_DB=legal_ai_prod

# Authentication (CRITICAL: MUST be cryptographically generated 256-bit key >= 32 chars)
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=40
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=40

# SMTP (Production transactional provider: SendGrid / AWS SES / Resend / Google Workspace)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SENDGRID_OR_SES_API_KEY
SMTP_FROM_EMAIL=auth@legalintel.ai
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# AI / Google Gemini (Production API key with billing linked or dedicated quota)
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_FREE_TIER_DAILY_LIMIT=1500
AI_WARNING_THRESHOLD_PERCENT=80.0

# LangSmith Observability (Production error and audit tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=YOUR_PRODUCTION_LANGCHAIN_API_KEY
LANGCHAIN_PROJECT=legal-intel-production
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Storage (Persistent mount volumes in production container)
CHROMA_PERSIST_DIR=/app/chroma_data
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
