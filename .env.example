# ==============================================================================
# AI Legal Document Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or .env.development, .env.staging, .env.production)
# DO NOT commit real secrets or API keys to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & ENVIRONMENT (Day 50)
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'staging', 'production', or 'test'
APP_ENV=development

# Debug mode: true in development, false in staging/production
DEBUG=true

# Logging level: 'DEBUG' in dev, 'INFO' in staging, 'INFO' or 'WARNING' in prod
LOG_LEVEL=DEBUG

# Backend server host port
BACKEND_PORT=8000

# Primary frontend URL (used for CORS and auth redirects)
FRONTEND_URL=http://localhost:5173

# Comma-separated or JSON list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Enterprise Security Headers (auto-enabled in staging & production)
STRICT_SECURITY_HEADERS=false

# Secure cookie flag for HTTPS-only transmission
SECURE_COOKIES=false

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (PostgreSQL 15)
# ------------------------------------------------------------------------------
# Local dev port 5433 (mapped from container 5432) or standard cloud database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_ai_db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (MUST be >= 32 chars in production)
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=40
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=40

# ------------------------------------------------------------------------------
# 4. EMAIL TWO-FACTOR AUTHENTICATION & SMTP (Day 14 / Day 50)
# ------------------------------------------------------------------------------
# If left unconfigured, OTP codes are logged to console (console mock delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@legalintel.ai
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & LLM ENGINE (Google Gemini Free Tier)
# ------------------------------------------------------------------------------
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_FREE_TIER_DAILY_LIMIT=1500
AI_WARNING_THRESHOLD_PERCENT=80.0

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & LANGSMITH TRACING (Day 29)
# ------------------------------------------------------------------------------
# Obtain key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-legal-document-intelligence
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 7. GOOGLE OAUTH 2.0 (Optional Single Sign-On)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 8. VECTOR DATABASE & PERSISTENCE (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_data

# ------------------------------------------------------------------------------
# 9. FILE STORAGE & UPLOAD POLICIES
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10


# --- Diagnostics Exposure (Security Hardening) ---
# Keep False in production. When False, unauthenticated /health/db and /metrics
# return only a minimal liveness signal; full diagnostics require an authenticated
# admin (/admin/db-health, /admin/telemetry). Set a METRICS_TOKEN to allow a
# trusted Prometheus scraper to read /metrics via a bearer token.
EXPOSE_PUBLIC_DIAGNOSTICS=False
METRICS_TOKEN=
