# ==============================================================================
# Development Environment Profile (.env.development.example)
# ==============================================================================
# Target: Local workstation development with Docker PostgreSQL & Vite dev server
# ==============================================================================

APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
STRICT_SECURITY_HEADERS=false
SECURE_COOKIES=false

# Relational Database (Local Docker port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/legal_ai_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_ai_db

# Authentication (Default dev secret allowed in development only)
JWT_SECRET_KEY=d8da31939b4a5ad41b46ef880fa422b3b02d4f869603292f63c2bb61d46002e4
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=40
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=40

# SMTP (Console mock delivery enabled by leaving username empty)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@legalintel.ai
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# AI / Google Gemini
GEMINI_API_KEY=YOUR_DEV_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
AI_FREE_TIER_DAILY_LIMIT=1500
AI_WARNING_THRESHOLD_PERCENT=80.0

# LangSmith Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=legal-intel-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Storage
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Diagnostics Exposure (Security Hardening) ---
# Keep False in production. When False, unauthenticated /health/db and /metrics
# return only a minimal liveness signal; full diagnostics require an authenticated
# admin (/admin/db-health, /admin/telemetry). Set a METRICS_TOKEN to allow a
# trusted Prometheus scraper to read /metrics via a bearer token.
EXPOSE_PUBLIC_DIAGNOSTICS=False
METRICS_TOKEN=
